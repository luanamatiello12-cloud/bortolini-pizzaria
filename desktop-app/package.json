{
  "name": "bortolini-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "App desktop (Electron) da Pizzaria Bortolini — sistema + WhatsApp Web lado a lado.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.bortolini.desktop",
    "productName": "Bortolini",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bortolini"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
